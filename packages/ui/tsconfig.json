{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // `main`/`types` apuntan al source (src/index.ts) y lo bundlea quien consume,
    // así que acá solo chequeamos tipos: no emitimos nada.
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
