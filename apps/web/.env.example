# ═══════════════════════════════════════════════════════════════════════════
# Pintura Pro — variables de entorno (apps/web)
# ═══════════════════════════════════════════════════════════════════════════
# Copiar a .env.local para desarrollo. En producción se cargan en el panel del
# hosting (Vercel → Settings → Environment Variables).
#
# Las NEXT_PUBLIC_ se INLINEAN EN EL BUILD: si faltan al buildear, no alcanza
# con agregarlas después — hay que volver a buildear.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
# OBLIGATORIAS — sin estas el sitio no funciona de verdad
# ─────────────────────────────────────────────────────────────────────────

# Supabase → Settings → API. Sin la URL, TODA la app cae a datos de ejemplo y
# devuelve HTTP 200: parece andar y muestra pintores y obras inventados. Después
# de desplegar, verificar /api/health antes que nada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo servidor, NUNCA con prefijo NEXT_PUBLIC_. Saltea RLS: se usa para subir
# fotos al Storage y para mandar avisos por email. Sin esto se rompen la subida
# de portadas y de avatares.
SUPABASE_SERVICE_ROLE_KEY=

# El dominio público, SIN barra final (ej: https://pinturapro.com.ar).
# Si falta: robots.txt y sitemap.xml publican URLs a localhost, las tarjetas de
# OpenGraph quedan rotas, y los emails salen sin botón de acción, en silencio.
NEXT_PUBLIC_SITE_URL=


# ─────────────────────────────────────────────────────────────────────────
# OPCIONALES — si faltan, la función se apaga sin romper el resto
# ─────────────────────────────────────────────────────────────────────────

# Emails transaccionales (Resend). Sin la key no se manda NINGÚN email y no
# queda registro: el cliente no se entera de que le cotizaron, y el pintor no se
# entera de que le aceptaron el trabajo.
RESEND_API_KEY=
RESEND_FROM=Pintura Pro <onboarding@resend.dev>

# ── Simulador de color (segmentación con IA) ────────────────────────────
# Sin REPLICATE_API_TOKEN ni SAM_BACKEND_URL, /api/segment responde 503 y el
# simulador queda sólo con el pincel manual. Replicate SE COBRA POR USO: poner
# un límite de gasto en el panel de Replicate antes de publicar.
REPLICATE_API_TOKEN=

# Un deployment propio (owner/name) mantiene una instancia tibia (~2s por
# pedido). Tiene prioridad sobre REPLICATE_VERSION, que arranca en frío y tarda
# entre 15 y 60 segundos la primera vez.
REPLICATE_DEPLOYMENT=
REPLICATE_VERSION=fe97b453a6455861e3bac769b441ca1f1086110da7466dbb65cf1eecfd60dc83

# OJO, IMPACTA EN LA FACTURA: el default del código es 32, no 16. Si no se
# setea, cada pedido cuesta el doble que con este valor.
REPLICATE_POINTS_PER_SIDE=16

# Umbrales de calidad de las máscaras. Defaults del código: 0.7 y 0.85.
REPLICATE_PRED_IOU_THRESH=0.7
REPLICATE_STABILITY_THRESH=0.85

# Alternativa a Replicate: un backend de segmentación propio. Si está seteado,
# tiene prioridad sobre Replicate.
SAM_BACKEND_URL=
SAM_BACKEND_TOKEN=
