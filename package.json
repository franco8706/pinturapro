{
  "name": "pinturapro",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "overridesReason": "Parches de seguridad sobre transitivas que el paquete padre todavía trae vulnerables (sharp/postcss llegan por next).",
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.3",
      "postcss": "^8.5.25"
    }
  }
}